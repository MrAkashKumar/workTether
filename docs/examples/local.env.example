# Documentation template only; the server does not automatically load this file.
# Supply these variables to a process started from the repository root.
# Local development only. The service always binds to loopback.
PORT=4318
WORKTETHER_DB=data/worktether.sqlite
# Comma-separated browser origins, only change for a trusted local frontend.
WORKTETHER_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4318,http://localhost:4318

# Set false with a NEW database path to start without sample accounts.
WORKTETHER_SEED=true
